# gemini until you intentionally call Nemotron. nemotron spends Token Factory balance.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Token Factory → API keys → Create. Paste the key only. No quotes, no "Bearer ".
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_BASE_URL=https://api.tokenfactory.nebius.com/v1

# 1 runs tests/test_remote.py against the network. Default pytest stays offline.
NIGHTGUARD_REMOTE=0

# --llm nemotron: only Update tomorrow's rules hits Token Factory. Night Pass A/B stay FakeLLM.
# Unused dollars die at the hour. No carry to the next hour or the next day.
NIGHTGUARD_HOURLY_USD=0.02

# Public demo only: minimum seconds between successful Morning Updates.
NIGHTGUARD_MORNING_COOLDOWN_SEC=30
